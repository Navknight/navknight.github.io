---
import Base from '../layouts/Base.astro'
---
<Base title="Page Not Found" description="This page doesn't exist.">
  <section class="notfound">
    <p class="big" aria-hidden="true">404</p>
    <h1>Page not found</h1>
    <p class="lede">That page doesn't exist. Try one of these instead.</p>
    <div class="actions">
      <a class="btn primary" href="/">Home</a>
      <a class="btn" href="/blog">Blog</a>
      <a class="btn" href="/dsa">DSA notes</a>
    </div>
  </section>
</Base>
