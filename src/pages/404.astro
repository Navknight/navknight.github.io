---
import Base from '../layouts/Base.astro'
---
<Base title="Page not found" description="This page doesn’t exist.">
  <section class="notfound">
    <p class="label"><b>404</b> / Not found</p>
    <h1>Nothing <em class="hl">here</em>.</h1>
    <p class="lede">This page moved, or never existed. Problem notes are under DSA notes, and posts are under Blog.</p>
    <div class="actions">
      <a class="btn primary" href="/">Go home</a>
      <a class="btn" href="/dsa">DSA notes</a>
      <a class="btn" href="/blog">Blog</a>
    </div>
  </section>
</Base>
