---
import Base from '../layouts/Base.astro'
---
<Base title="Page not found" description="This page doesn’t exist.">
  <section class="notfound">
    <h1>Nothing here.</h1>
    <p class="lede">The page you were after has moved or never existed. The problem notes live under DSA notes, and the posts under Blog.</p>
    <div class="actions">
      <a class="btn primary" href="/">Go home</a>
      <a class="btn" href="/dsa">DSA notes</a>
      <a class="btn" href="/blog">Blog</a>
    </div>
  </section>
</Base>
