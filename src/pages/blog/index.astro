---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { vtName } from '../../data/site.js'

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const tagsOf = (t) => (Array.isArray(t) ? t : t ? [t] : [])
const readingTime = (body = '') => Math.max(1, Math.round(body.split(/\s+/).filter(Boolean).length / 220))
---
<Base title="Blog" description="Notes on systems, browsers, and whatever I’m learning.">
  <header class="page-head">
    <p class="label"><b>Blog</b> / {posts.length} posts</p>
    <h1>Things I <em class="hl">wrote down</em>.</h1>
    <p class="lede">Systems, browsers, and whatever I’m learning that week. There’s an <a href="/rss.xml">RSS feed</a> too.</p>
  </header>
  <ul class="rows">
    {posts.map((post) => (
      <li>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <div>
          <h3 style={`view-transition-name:${vtName('post', post.id)}`}><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          {tagsOf(post.data.tags).length > 0 && (
            <ul class="tags">{tagsOf(post.data.tags).map((t) => <li class="tag">{t}</li>)}</ul>
          )}
        </div>
        <span class="rt">{readingTime(post.body)} min read</span>
      </li>
    ))}
  </ul>
</Base>
