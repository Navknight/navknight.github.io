---
import { getCollection, render } from 'astro:content'
import path from 'node:path'
import Base from '../../../layouts/Base.astro'
import ProblemTable from '../../../components/ProblemTable.astro'
import { problemRows, byDifficulty } from '../../../lib/dsa.js'

export async function getStaticPaths() {
  const topics = (await getCollection('dsa')).filter((e) => e.id.startsWith('topics/'))
  return topics.map((entry) => ({ params: { slug: entry.id.slice('topics/'.length) }, props: { entry } }))
}

function makeDescription(data, body, title) {
  if (data.description) return String(data.description)
  const plain = body
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/!\[\[[^\]]*\]\]/g, ' ')
    .replace(/\[\[([^\]|]+)\|?([^\]]*)\]\]/g, (_, n, a) => a || n)
    .replace(/[#*_`$>-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
  return plain ? plain.slice(0, 155) : `${title} — DSA notes by Abhinav Gupta`
}

const { entry } = Astro.props
const { Content } = await render(entry)
const title = path.basename(entry.filePath ?? entry.id, '.md')
const description = makeDescription(entry.data, entry.body ?? '', title)

const problems = problemRows(await getCollection('dsa'))
  .filter((p) => p.topics.some((t) => t.toLowerCase() === title.toLowerCase()))
  .sort(byDifficulty)
---
<Base title={title} description={description}>
  <header class="page-head">
    <p class="crumbs"><a href="/dsa">DSA</a> / Topics</p>
    <h1>{title}</h1>
  </header>
  <article class="prose topic-prose">
    <Content />
  </article>
  <h2>Problems <span class="h-count">{problems.length}</span></h2>
  <ProblemTable rows={problems} />
</Base>
