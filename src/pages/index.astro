---
import Base from '../layouts/Base.astro'
import Insight from '../components/Insight.astro'
import { getCollection } from 'astro:content'
import { problemRows } from '../lib/dsa.js'
import Diagram from '../components/Diagram.astro'
import { decisions, projects, vtName } from '../data/site.js'

const posts = (await getCollection('blog')).sort((a, b) => b.data.date - a.data.date).slice(0, 3)

const dsa = await getCollection('dsa')
const dated = new Map(dsa.map((e) => [e.id, e.data.date]))
const problems = problemRows(dsa)
const recent = problems
  .filter((p) => p.insight && dated.get(`problems/${p.slug}`))
  .sort((a, b) => dated.get(`problems/${b.slug}`) - dated.get(`problems/${a.slug}`))
  .slice(0, 5)

const readingTime = (body = '') => Math.max(1, Math.round(body.split(/\s+/).filter(Boolean).length / 220))
const fmt = (d) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Abhinav Gupta',
  url: 'https://navknight.github.io',
  sameAs: ['https://github.com/Navknight', 'https://linkedin.com/in/abhinav-gupta-iitt/'],
  jobTitle: 'Software Engineer (Full-Stack)',
}
---
<Base
  title="Abhinav Gupta"
  description="Abhinav Gupta is a full-stack software engineer who builds backend platforms and browser tooling, with security experience. Previously at Zscaler and SquareX; open to new roles."
  jsonLd={jsonLd}
>
  <section class="hero">
    <h1 class="hero-line">I build backend systems, and I’ve spent two years convincing Chromium to do things it was never built for.</h1>
    <div class="hero-body">
      <p class="lede">
        That was at SquareX, which Zscaler bought partway through. Now I’m after
        architecture roles, where drawing the boxes and arrows is the actual job.
        Below are a few I drew earlier.
      </p>
      <div class="actions">
        <a class="btn primary" href="mailto:abhi.gupta8802@gmail.com">Email me</a>
        <a class="btn" href="https://github.com/Navknight">GitHub</a>
        <a class="btn" href="https://linkedin.com/in/abhinav-gupta-iitt/">LinkedIn</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="decisions-h">
    <h2 id="decisions-h" class="big-h">Decisions, and what they cost</h2>
    <div class="decisions">
      {decisions.map((d) => (
        <article class="decision" id={d.id}>
          <div class="d-meta">
            <h3><a href={d.href}>{d.name}</a></h3>
            <p>{d.what}</p>
            <ul class="tags">{d.stack.map((s) => <li class="tag">{s}</li>)}</ul>
          </div>
          <div class="d-body">
            <p class="d-problem">{d.problem}</p>
            <Diagram id={`dg-${d.id}`} title={`${d.name}: ${d.problem}`} {...d.diagram} />
            <dl class="d-record">
              <div><dt>What I chose</dt><dd>{d.chose}</dd></div>
              <div><dt>What it cost</dt><dd>{d.cost}</dd></div>
            </dl>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="smaller-h">
    <div class="section-head">
      <h2 id="smaller-h">Smaller things</h2>
      <a href="/about">Work history</a>
    </div>
    <ul class="work">
      {projects.map((p) => (
        <li>
          <h3><a href={p.href}>{p.name}</a></h3>
          <p>{p.blurb}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="writing-h">
    <div class="section-head">
      <h2 id="writing-h">Writing</h2>
      <a href="/blog">All posts</a>
    </div>
    <ul class="rows">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          <div>
            <h3 style={`view-transition-name:${vtName('post', post.id)}`}><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </div>
          <span class="rt">{readingTime(post.body)} min</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="notes-h">
    <div class="section-head">
      <h2 id="notes-h">Recently solved</h2>
      <a href="/dsa">All {problems.length} problems</a>
    </div>
    <ul class="insights">
      {recent.map((p) => (
        <li>
          <a href={`/dsa/${p.slug}/`}>{p.name}</a>
          <p><Insight text={p.insight} /></p>
        </li>
      ))}
    </ul>
    <p class="note-foot">
      I write up every problem I solve in an Obsidian vault: the one idea that
      cracks it, the complexity, and the code. <a href="/lab">The lab</a> has
      two small games about caches and backend latency.
    </p>
  </section>
</Base>
