---
// A small system diagram. Boxes sit on the same lip as buttons, arrows say what
// flows, and `hot` marks the path the decision is about. Coordinates are in
// viewBox units; the SVG scales to the column and scrolls sideways on phones.
interface Node { id: string; x: number; y: number; w: number; h?: number; label: string; sub?: string; hot?: boolean }
interface Edge { from: string; to: string; label?: string; hot?: boolean; via?: 'h' | 'v'; d?: string; at?: [number, number] }
interface Group { x: number; y: number; w: number; h: number; label: string }
interface Props { id: string; title: string; width: number; height: number; nodes: Node[]; edges?: Edge[]; groups?: Group[] }

const { id, title, width, height, nodes, edges = [], groups = [] } = Astro.props
const LIP = 4
const box = Object.fromEntries(nodes.map((n) => [n.id, { ...n, h: n.h ?? 52 }]))

// Orthogonal route between two boxes; one elbow when they don't line up.
function route(e: Edge) {
  if (e.d) return { d: e.d, mid: e.at ?? [0, 0], side: 'h' }
  const a = box[e.from], b = box[e.to]
  const [acx, acy] = [a.x + a.w / 2, a.y + a.h / 2]
  const [bcx, bcy] = [b.x + b.w / 2, b.y + b.h / 2]
  const apart = b.x >= a.x + a.w || b.x + b.w <= a.x
  if (e.via === 'h' || (!e.via && apart)) {
    const right = bcx > acx
    const x1 = right ? a.x + a.w : a.x
    const x2 = right ? b.x : b.x + b.w
    const mx = (x1 + x2) / 2
    const d = acy === bcy ? `M${x1} ${acy}H${x2}` : `M${x1} ${acy}H${mx}V${bcy}H${x2}`
    return { d, mid: e.at ?? [mx, acy === bcy ? acy : (acy + bcy) / 2], side: acy === bcy ? 'h' : 'v' }
  }
  const down = bcy > acy
  const y1 = down ? a.y + a.h + LIP : a.y
  const y2 = down ? b.y : b.y + b.h + LIP
  const my = (y1 + y2) / 2
  const d = acx === bcx ? `M${acx} ${y1}V${y2}` : `M${acx} ${y1}V${my}H${bcx}V${y2}`
  // a straight vertical arrow gets its label beside it, not across it
  return { d, mid: e.at ?? [(acx + bcx) / 2, my], side: acx === bcx ? 'v' : 'h' }
}
const routed = edges.map((e) => ({ ...e, ...route(e) }))
---
<figure class="diagram">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${id}-t`}>
    <title id={`${id}-t`}>{title}</title>
    <defs>
      <marker id={`${id}-a`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="arrow" d="M0 1 9 5 0 9z" /></marker>
      <marker id={`${id}-h`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path class="arrow hot" d="M0 1 9 5 0 9z" /></marker>
    </defs>
    {groups.map((g) => (
      <g class="group">
        <rect x={g.x} y={g.y} width={g.w} height={g.h} rx="16" />
        <text x={g.x + 14} y={g.y + g.h - 12}>{g.label}</text>
      </g>
    ))}
    {routed.map((e) => (
      <path class:list={['edge', { hot: e.hot }]} d={e.d} marker-end={`url(#${id}-${e.hot ? 'h' : 'a'})`} />
    ))}
    {nodes.map((n) => {
      const b = box[n.id]
      return (
        <g class:list={['node', { hot: n.hot }]}>
          <rect class="lip" x={b.x} y={b.y + LIP} width={b.w} height={b.h} rx="10" />
          <rect class="face" x={b.x} y={b.y} width={b.w} height={b.h} rx="10" />
          <text class="label" x={b.x + b.w / 2} y={b.y + (n.sub ? b.h / 2 - 4 : b.h / 2 + 5)}>{n.label}</text>
          {n.sub && <text class="sub" x={b.x + b.w / 2} y={b.y + b.h / 2 + 13}>{n.sub}</text>}
        </g>
      )
    })}
    {routed.filter((e) => e.label).map((e) => (
      <text class:list={['elabel', { hot: e.hot }]} x={e.mid[0] + (e.side === 'v' ? 8 : 0)} y={e.mid[1] - (e.side === 'v' ? -4 : 8)} text-anchor={e.side === 'v' ? 'start' : 'middle'}>{e.label}</text>
    ))}
  </svg>
</figure>
